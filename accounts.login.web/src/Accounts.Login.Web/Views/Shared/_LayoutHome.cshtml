@using Accounts.Login.Infra.Responses
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project.Sync </title>
      <link rel="icon" type="image/x-icon" href="@ViewData["FileApiUrlPublic"]/imgs/favicon_io/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet">
    <link rel="stylesheet" href="@ViewData["FileApiUrlPublic"]/css/base.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Accounts.Login.Web.styles.css" asp-append-version="true" />
    <style>
        .dropdown-toggle::after{
            margin-left:0px;
        }
    </style>
</head>
<body class="text-center" style="align-items:normal;">
    <main>
        <div id="header" class="container-fluid mt-2">
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Home" asp-action="Index">
                <img src="@ViewData["FileApiUrlPublic"]/imgs/logo-market-fake.png" alt="" style="max-width: 150px;">
                </a>
                <div class="d-flex align-items-center">
                    <figure class="user-image me-3" style="width:50px;height:50px;border-radius:50%;background-size:cover;background-position:center;background-image: url('@(@User.GetImage()?.Length > 5 ? User.GetImage() : "")');margin:0;"></figure>
                    <div class="dropdown">
                        <div class="d-flex align-items-center">
                            <div class="text-start d-none d-md-block">
                                <b>@User.GetName()</b><br />
                                <small>@User.GetEmail()</small>
                            </div>
                            <button class="btn btn-light dropdown-toggle p-1 d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background:transparent; border:none;padding:10px!important;height:50px;">
                                <span class="visually-hidden">Abrir menu</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li class="d-block d-md-none">
                                    <div class="fw-bold ps-1 pe-1">@User.GetName()</div>
                                    <div class="small ps-1 pe-1">@User.GetEmail()</div>
                                    <hr class="dropdown-divider">
                                </li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Update">Update user</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Logout" asp-action="Index">Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="pt-2 pb-2 mt-2" style="background:var(--color-primary);">
            <div class="container-fluid pt-1 pb-1">
                <div class="row align-items-center">
                    <div class="col d-flex align-items-center">
                        <div>
                        </div>
                    </div>
                    <div class="col d-flex align-items-center justify-content-end">
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="min-vh-100 mt-4">
                @RenderBody()
            </div>
            <footer>

                <p class="mt-5 mb-3 text-muted">© 2024–2025</p>
            </footer>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ModalSuccessResponse")
    @await Html.PartialAsync("_ModalErrorResponse")
</body>
</html>
