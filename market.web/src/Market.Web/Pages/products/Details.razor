@page "/products/{ProductId:guid}"
@page "/{Slug}"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@inject ProductService ProductService

@attribute [Authorize]

<PageTitle>@(details?.Product.Name ?? "Product Details")</PageTitle>

<div class="container product-details">
    <a class="product-details__back" href="products">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <span>Back to products</span>
    </a>

    @if (isLoading)
    {
        <p class="text-muted">Loading product...</p>
    }
    else if (details is null)
    {
        <div class="alert alert-warning mb-0">
            Product not found.
        </div>
    }
    else
    {
        <section class="product-details__layout">
            <div class="product-details__gallery">
                <div class="product-details__media">
                    <img src="@SelectedImageUrl" alt="@details.Product.Name" />
                </div>

                @if (details.Photos.Count > 1)
                {
                    <div class="product-details__thumbs" aria-label="Product photos">
                        @foreach (var photo in details.Photos)
                        {
                            <button type="button"
                                    class="@GetThumbClass(photo)"
                                    @onclick="() => SelectPhoto(photo)">
                                <img src="@photo.Url" alt="@(photo.Description ?? details.Product.Name)" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="product-details__panel">
                <p class="product-details__eyebrow">Product @details.Product.Code</p>
                <h1>@details.Product.Name</h1>
                <p class="product-details__description">@details.Product.Summary</p>

                <div class="product-details__price-group">
                    @if (details.Price is null)
                    {
                        <strong class="product-details__price">Price unavailable</strong>
                    }
                    else
                    {
                        @if (details.Price.OriginalPrice > details.Price.SalePrice)
                        {
                            <span class="product-details__price-original">@FormatCurrency(details.Price.OriginalPrice, details.Price.Currency)</span>
                        }
                        <strong class="product-details__price">@FormatCurrency(details.Price.SalePrice, details.Price.Currency)</strong>
                    }
                </div>

                <div class="product-details__quantity">
                    <label for="product-quantity" class="form-label">Quantity</label>
                    <select id="product-quantity" class="form-select" @bind="selectedQuantity" disabled="@(!CanBuy)">
                        @foreach (var quantity in Quantities)
                        {
                            <option value="@quantity">@quantity</option>
                        }
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary" disabled="@(!CanBuy)">
                        <i class="bi bi-cart-plus" aria-hidden="true"></i>
                        Add to cart
                    </button>
                </div>
            </div>
        </section>

        <section class="product-details__info" aria-labelledby="product-info-title">
            <h2 id="product-info-title">Description</h2>
            <p>@details.Product.Description</p>
        </section>
        @if (details.Informations.Count(w => w.Type != 1) > 0)
        {
            <section class="product-details__info" aria-labelledby="product-info-title">
                <h2 id="product-info-title">Product information</h2>
                <dl>
                    @foreach (var info in details.Informations.Where(w => w.Type != 7 && w.Type != 1))
                    {
                        <div>
                            <dt>@info.Label</dt>
                            <dd>@info.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }

        @if (details.Informations.Count(w => w.Type == 1) > 0)
        {
            <section class="product-details__info" aria-labelledby="product-info-title">
                <h2 id="product-info-title">Abilities</h2>
                <dl>
                    @foreach (var info in details.Informations.Where(w => w.Type == 1))
                    {
                        <div>
                            <dt>@info.Label</dt>
                            <dd>@info.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }
    }
</div>

@code {
    [Parameter]
    public Guid ProductId { get; set; }

    [Parameter]
    public string? Slug { get; set; }

    private ProductDetailsViewDto? details;
    private ProductPhotoDto? selectedPhoto;
    private bool isLoading = true;
    private int selectedQuantity = 1;
    private static readonly int[] Quantities = Enumerable.Range(1, 10).ToArray();

    private string SelectedImageUrl
    {
        get
        {
            if (selectedPhoto is not null)
            {
                return selectedPhoto.Url;
            }

            var image = details?.Product.Images?.FirstOrDefault(img => img.IsMain)
                ?? details?.Product.Images?.FirstOrDefault();

            return image?.Url ?? "https://placehold.co/640x460/e5e7eb/475569?text=Product";
        }
    }

    private bool CanBuy => details?.Stock is null || details.Stock.AvailableStock > 0;

    private string AvailableStockLabel => details?.Stock is null
        ? "Stock unavailable"
        : details.Stock.AvailableStock > 0
            ? $"{details.Stock.AvailableStock} available"
            : "Out of stock";

    private string ReservedStockLabel => details?.Stock is null
        ? "No stock information returned"
        : $"{details.Stock.ReservedStock} reserved, {details.Stock.SoldStock} sold";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        selectedPhoto = null;

        details = ProductId != Guid.Empty
            ? await ProductService.GetDetailsAsync(ProductId)
            : await ProductService.GetDetailsBySlugAsync(Slug ?? string.Empty);

        selectedPhoto = details?.Photos.FirstOrDefault(photo => photo.Type == 1)
            ?? details?.Photos.FirstOrDefault();
        isLoading = false;
    }

    private void SelectPhoto(ProductPhotoDto photo)
    {
        selectedPhoto = photo;
    }

    private string GetThumbClass(ProductPhotoDto photo)
    {
        return selectedPhoto?.Id == photo.Id
            ? "product-details__thumb product-details__thumb--active"
            : "product-details__thumb";
    }

    private static string FormatCurrency(decimal value, string? currency)
    {
        var culture = string.Equals(currency, "BRL", StringComparison.OrdinalIgnoreCase)
            ? CultureInfo.GetCultureInfo("pt-BR")
            : CultureInfo.GetCultureInfo("en-US");

        return value.ToString("C", culture);
    }
}
