<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MessagingPackagesVersion>1.0.0.18</MessagingPackagesVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accounts.Core\Accounts.Core.csproj" />
    <ProjectReference Include="..\Accounts.Infrastructure\Accounts.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.1" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Messaging.Abstractions" Version="$(MessagingPackagesVersion)" />
    <PackageReference Include="Messaging.Contracts" Version="$(MessagingPackagesVersion)" />
  </ItemGroup>
</Project>
